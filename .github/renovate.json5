{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Kotori316/common-script:renovate-default"
  ],
  "baseBranches": [
    "1.21",
    "$default"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gradle"
      ],
      "matchPackagePatterns": [
        "^net.neoforged.gradle.userdev"
      ],
      "enabled": false
    }
  ]
}
