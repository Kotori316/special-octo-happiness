{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Kotori316/common-script:renovate-default"
  ],
  "baseBranches": [
    "1.21",
    "1.21.11",
    "26.1",
    "$default"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchDepNames": ["/^org.spongepowered.gradle.vanilla/"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
